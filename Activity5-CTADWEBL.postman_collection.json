    {
      "name": "1. Security Headers (Helmet & CORS)",
      "item": [
        {
          "name": "1.1 GET / - check Helmet security headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Standard JSON format (success: true)\", () => { const b = pm.response.json(); pm.expect(b.success).to.eql(true); pm.expect(b.message).to.be.a(\"string\"); });",
                  "pm.test(\"Content-Security-Policy is set\", () => { pm.expect(pm.response.headers.get(\"Content-Security-Policy\")).to.include(\"default-src 'none'\"); });",
                  "pm.test(\"X-Frame-Options is DENY\", () => { pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.eql(\"DENY\"); });",
                  "pm.test(\"X-Content-Type-Options is nosniff\", () => { pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"); });",
                  "pm.test(\"X-Powered-By (Express) is hidden\", () => { pm.expect(pm.response.headers.get(\"X-Powered-By\")).to.be.undefined; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1.2 GET /api/v1/products from an allowed origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Standard JSON format (success: true)\", () => { const b = pm.response.json(); pm.expect(b.success).to.eql(true); pm.expect(b.message).to.be.a(\"string\"); });",
                  "pm.test(\"CORS reflects the allowed origin\", () => { pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:5173\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
